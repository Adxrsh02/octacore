# ==============================================================================
# OCTACORE FITNESS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate the values for production deployment.
# NEVER commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & Domain Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://octacorefitness.com

# ------------------------------------------------------------------------------
# 2. Lead Notification Email (Resend)
# ------------------------------------------------------------------------------
# Obtain API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=OCTACORE Fitness <leads@octacorefitness.com>

# Branch-Specific Email Recipients for Enquiries
LEAD_EMAIL_DEFAULT=contact@octacorefitness.com
LEAD_EMAIL_NERUL=nerul@octacorefitness.com
LEAD_EMAIL_AIROLI=airoli@octacorefitness.com

# ------------------------------------------------------------------------------
# 3. Cloudflare Turnstile Bot Protection
# ------------------------------------------------------------------------------
# Obtain keys from Cloudflare Dashboard > Turnstile
# Leave empty in local dev to bypass Turnstile verification automatically
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. Analytics & Tracking
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Gated behind user cookie consent banner
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 5. Search Engine Webmaster Verification Tags
# ------------------------------------------------------------------------------
# Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster msvalidate.01 token
BING_SITE_VERIFICATION=

