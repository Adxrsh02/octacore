{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octacore-fitness",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "OCTACORE_LEADS_KV",
      "id": "octacore_leads_kv_prod_id",
      "preview_id": "octacore_leads_kv_preview_id"
    }
  ],
  "d1_databases": [
    {
      "binding": "OCTACORE_DB",
      "database_name": "octacore-db",
      "database_id": "octacore_d1_database_id",
      "preview_database_id": "octacore_d1_preview_database_id"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://octacorefitness.com",
    "NEXT_PUBLIC_SITE_NAME": "OCTACORE Fitness",
    "LEAD_EMAIL_NERUL": "nerul@octacorefitness.com",
    "LEAD_EMAIL_AIROLI": "airoli@octacorefitness.com",
    "RESEND_FROM_EMAIL": "OCTACORE Fitness <leads@octacorefitness.com>"
  },
  "env": {
    "preview": {
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://preview.octacorefitness.com"
      }
    }
  }
}

