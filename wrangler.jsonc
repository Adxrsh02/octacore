{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octacore",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "OCTACORE_LEADS_KV",
      "id": "08e07cca2ca540059f12c52314a8d866",
      "preview_id": "8dffc80f29a24d7b8af697502cefff0b"
    }
  ],
  "d1_databases": [
    {
      "binding": "OCTACORE_DB",
      "database_name": "octacore-db",
      "database_id": "8da97fb8-1462-425c-a738-3659305f0b39"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://octacorefitness.com",
    "NEXT_PUBLIC_SITE_NAME": "OCTACORE Fitness",
    "LEAD_EMAIL_NERUL": "nerul@octacorefitness.com",
    "LEAD_EMAIL_AIROLI": "airoli@octacorefitness.com",
    "RESEND_FROM_EMAIL": "OCTACORE Fitness <leads@octacorefitness.com>"
  }
}
